# Central Configuration Variables for JAX Multi-Node on GKE Learning Plan
# Edit these variables to customize your GCP project and cluster settings.

PROJECT_ID="multinode-gke-dev-test"
REGION="us-central1"
ZONE="us-central1-a"
CLUSTER_NAME="jax-distributed-cluster"
NETWORK_NAME="jax-network"
SUBNET_NAME="jax-subnet"

# Artifact Registry Config
ARTIFACT_REGISTRY_REPO="jax-gke-repo"
CPU_IMAGE_NAME="jax-cpu-multinode"
GPU_IMAGE_NAME="jax-gpu-multinode"
TPU_IMAGE_NAME="jax-tpu-multinode"
IMAGE_TAG="latest"

# CPU Multi-Node Settings (Zero-Quota Default Testing)
CPU_NODE_COUNT=2
CPU_SCALE_NODE_COUNT=20
CPU_VIRTUAL_DEVICES_PER_HOST=4

# GPU Node Pool Settings (Optional Accelerator)
GPU_NODE_POOL_NAME="gpu-pool"
GPU_MACHINE_TYPE="g2-standard-8"
GPU_TYPE="nvidia-l4"
GPU_COUNT_PER_NODE=1
GPU_NODE_COUNT=2

# TPU Node Pool Settings (Optional Accelerator)
TPU_NODE_POOL_NAME="tpu-v5e-pool"
TPU_MACHINE_TYPE="ct5lp-hightpu-4t"
TPU_TOPOLOGY="2x4"
TPU_NODE_COUNT=2

# Kubernetes & Operator Versions
JOBSET_VERSION="v0.12.0"
KUEUE_VERSION="v0.8.0"
